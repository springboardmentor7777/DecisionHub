@"
# Root-level ignores — catch IDE and build artifacts anywhere
.idea/
target/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
*.log
*.env
application-local.properties

# Catch build/IDE folders inside any subfolder (e.g. backend/)
