{
  "info": {
    "_postman_id": "decisionhub-api-v2",
    "name": "DecisionHub API",
    "description": "Complete API collection for DecisionHub — authentication, communities, decisions, options, votes, comments, notifications, and reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has userId', () => pm.expect(pm.response.json()).to.have.property('userId'));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('user_id', data.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"securePass1\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"]},
            "description": "Register a new user. Returns 201 with UserResponse. Returns 409 if email is already registered."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has accessToken', () => pm.expect(pm.response.json()).to.have.property('accessToken'));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.accessToken);",
                  "pm.collectionVariables.set('user_id', data.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"securePass1\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"]},
            "description": "Login. Saves the returned JWT to {{access_token}}. Returns 401 for bad credentials."
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has email', () => pm.expect(pm.response.json()).to.have.property('email'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}"}]},
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api","auth","me"]},
            "description": "Returns the authenticated user's profile. Requires Bearer token."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has userId', () => pm.expect(pm.response.json()).to.have.property('userId'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}"}]},
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api","users","{{user_id}}"]},
            "description": "Get a user by ID. Returns 404 if not found."
          }
        },
        {
          "name": "Update User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Full name updated', () => pm.expect(pm.response.json().fullName).to.equal('Alice Updated'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{access_token}}"}]},
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Updated\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api","users","{{user_id}}"]},
            "description": "Update authenticated user's full name. Returns 403 if updating another user's profile."
          }
        }
      ]
    },
